    rate_limit {
        zone assets_burst {
            match {
                path_regexp (?i)\.(ico|png|webp|jpg|jpeg|gif|avif|css|js|mjs|svg|woff|woff2|ttf|otf|md)$
            }            
            key {http.request.header.CF-Connecting-IP}
            window 1m
            events 1000        
            ipv4_prefix 24
            ipv6_prefix 64
        }

        zone assets_core_burst {
            match {
                path /_core/*
            }            
            key {http.request.header.CF-Connecting-IP}
            window 1m
            events 1000        
            ipv4_prefix 24
            ipv6_prefix 64
        }

        zone app_standard {
                match {
                    not path_regexp (?i)\.(ico|png|webp|jpg|jpeg|gif|avif|css|js|mjs|svg|woff|woff2|ttf|otf|md)$
                    not path /_core/*
                }
                key {http.request.header.CF-Connecting-IP}
                window 1m
                events 1000 
                ipv4_prefix 24
                ipv6_prefix 64       
            }

        zone app_sustained {
                match {
                    not path_regexp (?i)\.(ico|png|webp|jpg|jpeg|gif|avif|css|js|mjs|svg|woff|woff2|ttf|otf|md)$
                    not path /_core/*
                }
                key {http.request.header.CF-Connecting-IP}
                events 2000        
                window 10m
                ipv4_prefix 24
                ipv6_prefix 64
            }  
        log_key   
	}
