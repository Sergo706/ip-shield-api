    rate_limit {
        zone assets_burst {
            match {
                path_regexp (?i)\.(ico|png|webp|jpeg|css|js|svg|woff|woff2)$
            }            
            key    {remote_host}
			window 1m
			events 3000        
        }

        zone app_standard {
                match {
                    not path_regexp (?i)\.(ico|png|webp|jpeg|css|js|svg|woff|woff2)$
                }
                key    {remote_host}
                window 1m
                events 2000        
            }

        zone app_sustained {
                match {
                    not path_regexp (?i)\.(ico|png|webp|jpeg|css|js|svg|woff|woff2)$
                }
                key    {remote_host}
                events 3000        
                window 10m
            }
        log_key   
	}
