 rate_limit {
		zone auth_fast {
        match {
            path /auth* /login /logout /oauth* /users/login-to-account*
		}
			key    {remote_host}
			events 2        
			window 2s       
		}

		zone auth_long {
         match {
            path /auth* /login /logout /oauth* /users/login-to-account*
		}
			key    {remote_host}
			events 10
			window 20m
		}

		zone auth_black_strict {
			match { 
		    path /auth* /login /logout /oauth* /users/login-to-account*
		}
			key    {remote_host}
			events 20
			window 24h
		}
		
		zone auth_black_extreme {
        match {
            path /auth* /login /logout /oauth* /users/login-to-account*
		}
			key  {remote_host}
			events 40
			window 32h
		}

		zone signup_daily_limit {
        match { 
            path /signup /users/createAccount* /users/createProfile* /users/createUser* /users/init-password-reset* /users/avatars/uploadAvatar*
        }
        key    {remote_host}
        events 5
        window 24h
    }

		log_key                       
	}