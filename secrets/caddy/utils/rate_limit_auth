 rate_limit {
		zone auth_fast {
        match {
            path /auth* /login /logout /oauth* /account*
		}
			key {http.request.header.CF-Connecting-IP}
			events 2        
			window 2s       
		}

		zone auth_long {
         match {
            path /auth* /login /logout /oauth* /account*
		}
			key {http.request.header.CF-Connecting-IP}
			events 10
			window 20m
		}

		zone auth_black_strict {
			match { 
		    path /auth* /login /logout /oauth* /account*
		}
			key {http.request.header.CF-Connecting-IP}
			events 20
			window 24h
			ipv4_prefix 24
            ipv6_prefix 64
		}
		
		zone auth_black_extreme {
        match {
            path /auth* /login /logout /oauth* /account*
		}
			key {http.request.header.CF-Connecting-IP}
			events 40
			window 32h
			ipv4_prefix 24
            ipv6_prefix 64
		}

		zone signup_daily_limit {
        match { 
            path /signup /api/auth/reset-password
        }
        key {http.request.header.CF-Connecting-IP}
        events 5
        window 24h
		ipv4_prefix 24
        ipv6_prefix 64
    }

		zone auth_status {
		match {
			path /api/auth/users/authStatus
		}
		key {http.request.header.CF-Connecting-IP}
		events 2
		window 2s
	}

	zone private_keys {
		match {
			path /api/auth/api-tokens/*
		}
		key {http.request.header.CF-Connecting-IP}
		events 5
		window 1m
	}

		log_key                       
	}