{$DOMAIN:localhost} {
import ../utils/*

log http {
   output stdout
   format console {
   time_format rfc3339
 }
}

	request_body {
		max_size 10MB
	}
	
	@blocked {
		path /health /.git /github /known-hosts /store *.well-known /.env /.github /_nitro/* api/_mdc/*
	}

	@cachable {
		 path_regexp (?i)\.(ico|png|webp|jpeg|css|js|svg|woff|woff2)$2
	}
	
handle @cachable {
	header {
		?Cache-Control "private, max-age=31536000"
	}
}

handle @blocked {
    respond "Not Found" 404
}
	
	encode
	reverse_proxy {
		to http://dashboard:3000
		header_down Server
	     header_up X-Client-TLS-Version {tls_version}
   		 header_up X-Client-Cipher {tls_cipher}
		 header_up X-Real-IP {remote_host}
         header_up X-Forwarded-For {remote_host}
	}

}

http://{$DOMAIN:localhost} {
  redir https://{$DOMAIN:localhost}{uri}
}
