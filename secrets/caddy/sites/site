http://{$DOMAIN:localhost} {
import ../utils/*

log http {
   output stdout
   format console {
   time_format rfc3339
 }
}

	request_body {
		max_size 10MB
	}
	
	@blocked {
		path /health /.git /github /known-hosts /store *.well-known /.env /.github /_nitro/*
	}
	respond @blocked "Not Found" 404

	@cachable {
		path_regexp (?i)\.(ico|png|webp|jpg|jpeg|gif|avif|css|js|mjs|svg|woff|woff2|ttf|otf|md)$
	}
	header @cachable Cache-Control "public, max-age=31536000, immutable"

	@api_v1 {
		path /api/v1/*
	}
	header @api_v1 Cache-Control "no-store, no-cache, must-revalidate"

	encode
	@core_app {
        path /api/* /api* /dashboard* /account* /auth* /oauth* /signup* /login* /logout* /_core* /_core/* /api-tokens* /avatar* /check-register-waitlist* /demo* /health* /plans* /register-waitlist* /stats* /update-names*
    }

	@contact {
		path /contact*
		method POST
	}

    handle @core_app {
        reverse_proxy http://dashboard:3000 {
            header_down Server
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_down -x-client-id
       		header_down -X-Client-ID
        }
    }
	
	handle @contact {
		reverse_proxy http://dashboard:3000 {
            header_down Server
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_down -x-client-id
       		header_down -X-Client-ID
        }
	}
	
	handle {
		root * /var/www/static-site/.output/public 
		file_server {
			precompressed br zstd gzip
		}

		try_files {path} {path}.html /index.html
	}
	handle_errors {
		root * /var/www/static-site/.output/public
		@custom_err file /{err.status_code}.html
		handle @custom_err {
			rewrite * {file_match.relative}
			file_server
		}
		handle {
			rewrite * /{err.status_code}
			reverse_proxy https://http.cat {
				header_up Host http.cat
				replace_status {err.status_code}
			}
		}
	}
}