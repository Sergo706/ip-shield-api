http://{$DOMAIN:localhost} {
import ../utils/*

log http {
   output stdout
   format console {
   time_format rfc3339
 }
}

	request_body {
		max_size 10MB
	}
	
	@blocked {
		path /health /.git /github /known-hosts /store *.well-known /.env /.github /_nitro/*
	}
	respond @blocked "Not Found" 404

	@cachable {
		path_regexp (?i)\.(ico|png|webp|jpeg|css|js|svg|woff|woff2)$
	}
	header @cachable Cache-Control "public, max-age=31536000, immutable"


	encode
    @core_app {
        path /api/* /dashboard/* /auth* /oauth* /signup* /login* /logout* /contact* /_core/* /account*
	}

    handle @core_app {
        reverse_proxy http://dashboard:3000 {
            header_down Server
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_down -x-client-id
       		header_down -X-Client-ID
        }
    }

	
	handle {
		root * /var/www/static-site/.output/public 
		file_server {
			precompressed br zstd gzip
		}

		try_files {path} {path}.html /index.html
	}
	handle_errors {
		root * /var/www/static-site/.output/public
		@custom_err file /{err.status_code}.html
		handle @custom_err {
			rewrite * {file_match.relative}
			file_server
		}
		handle {
			rewrite * /{err.status_code}
			reverse_proxy https://http.cat {
				header_up Host http.cat
				replace_status {err.status_code}
			}
		}
	}
}