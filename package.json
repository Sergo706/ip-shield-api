{
  "name": "ip-shield-api-workspace",
  "private": true,
  "scripts": {
    "dev:static": "pnpm --filter @app/static dev",
    "dev:core": "pnpm --filter @app/core dev",
    "build:static": "pnpm --filter @app/static build",
    "generate:static": "pnpm --filter @app/static generate",
    "build:core": "pnpm --filter @app/core build",
    "typecheck:static": "pnpm --filter @app/static typecheck",
    "typecheck:core": "pnpm --filter @app/core typecheck",
    "lint:static": "pnpm --filter @app/static lint",
    "lint:core": "pnpm --filter @app/core lint",
    "dev:both": "pnpm --filter @app/static --filter @app/core dev"
  },
  "packageManager": "pnpm@10.30.3"
}
